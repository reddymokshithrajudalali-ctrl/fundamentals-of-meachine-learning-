def word_features(sentence, i):
    word = sentence[i]

    features = {
        'word.lower()': word.lower(),
        'word.isupper()': word.isupper(),
        'word.istitle()': word.istitle(),
        'word.isdigit()': word.isdigit(),
        'word.prefix': word[:2],
        'word.suffix': word[-2:],
        'word.length': len(word),
        'contains_digit': any(char.isdigit() for char in word)
    }

    if i > 0:
        previous = sentence[i - 1]
        features.update({
            'prev_word': previous.lower(),
            'prev_is_title': previous.istitle()
        })
    else:
        features['BOS'] = True

    if i < len(sentence) - 1:
        next_word = sentence[i + 1]
        features.update({
            'next_word': next_word.lower(),
            'next_is_title': next_word.istitle()
        })
    else:
        features['EOS'] = True

    return features

def sentence_features(sentence):
    return [word_features(sentence, i) for i in range(len(sentence))]

