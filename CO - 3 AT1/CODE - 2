import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score, adjusted_rand_score

digits = load_digits()

X = digits.data
y = digits.target

print("Digits dataset loaded successfully!")

print("\nDataset shape:")
print(X.shape)

print("\nNumber of classes:")
print(len(np.unique(y)))

print("\nFirst 5 rows:")
display(pd.DataFrame(X).head())

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

print("\nData standardized successfully!")

print("\nScaled data shape:")
print(X_scaled.shape)

n_clusters = 10

kmeans = KMeans(
    n_clusters=n_clusters,
    random_state=42,
    n_init=10
)

kmeans_labels = kmeans.fit_predict(X_scaled)

print("\nK-Means clustering completed!")

print("\nK-Means cluster counts:")
print(pd.Series(kmeans_labels).value_counts().sort_index())

gmm = GaussianMixture(
    n_components=n_clusters,
    random_state=42,
    covariance_type='full'
)

gmm_labels = gmm.fit_predict(X_scaled)

print("\nGaussian Mixture Model clustering completed!")

print("\nGMM cluster counts:")
print(pd.Series(gmm_labels).value_counts().sort_index())

kmeans_silhouette = silhouette_score(
    X_scaled,
    kmeans_labels
)

gmm_silhouette = silhouette_score(
    X_scaled,
    gmm_labels
)

kmeans_ari = adjusted_rand_score(
    y,
    kmeans_labels
)

gmm_ari = adjusted_rand_score(
    y,
    gmm_labels
)

print("\n==========================================")
print("CLUSTERING EVALUATION")
print("==========================================")

print("\nK-Means Silhouette Score:")
print(round(kmeans_silhouette, 4))

print("\nGMM Silhouette Score:")
print(round(gmm_silhouette, 4))

print("\nK-Means Adjusted Rand Index:")
print(round(kmeans_ari, 4))

print("\nGMM Adjusted Rand Index:")
print(round(gmm_ari, 4))

comparison = pd.DataFrame({
    'Algorithm': ['K-Means', 'Gaussian Mixture Model'],
    'Silhouette Score': [
        kmeans_silhouette,
        gmm_silhouette
    ],
    'Adjusted Rand Index': [
        kmeans_ari,
        gmm_ari
    ]
})

print("\nPerformance Comparison:")
display(comparison)

pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)

print("\nPCA completed successfully!")

print("\nPCA Explained Variance Ratio:")
print(pca.explained_variance_ratio_)

print("\nTotal Variance Explained:")
print(
    round(
        pca.explained_variance_ratio_.sum() * 100,
        2
    ),
    "%"
)

pca_df = pd.DataFrame(
    X_pca,
    columns=['PC1', 'PC2']
)

pca_df['KMeans_Cluster'] = kmeans_labels
pca_df['GMM_Cluster'] = gmm_labels
pca_df['Actual_Digit'] = y

print("\nPCA Data:")
display(pca_df.head())

plt.figure(figsize=(10, 7))

scatter = plt.scatter(
    pca_df['PC1'],
    pca_df['PC2'],
    c=pca_df['KMeans_Cluster'],
    cmap='viridis',
    s=20,
    alpha=0.7
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")

plt.title("K-Means Clusters using PCA")

plt.colorbar(
    scatter,
    label="K-Means Cluster"
)

plt.grid(True)

plt.show()

plt.figure(figsize=(10, 7))

scatter = plt.scatter(
    pca_df['PC1'],
    pca_df['PC2'],
    c=pca_df['GMM_Cluster'],
    cmap='viridis',
    s=20,
    alpha=0.7
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")

plt.title("Gaussian Mixture Model Clusters using PCA")

plt.colorbar(
    scatter,
    label="GMM Cluster"
)

plt.grid(True)

plt.show()

plt.figure(figsize=(10, 7))

scatter = plt.scatter(
    pca_df['PC1'],
    pca_df['PC2'],
    c=pca_df['Actual_Digit'],
    cmap='tab10',
    s=20,
    alpha=0.7
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")

plt.title("Actual Digits Classes using PCA")

plt.colorbar(
    scatter,
    label="Actual Digit"
)

plt.grid(True)

plt.show()

print("\n==========================================")
print("FINAL RESULTS")
print("==========================================")

print("Number of Clusters:", n_clusters)

print("\nK-Means Silhouette Score:",
      round(kmeans_silhouette, 4))

print("GMM Silhouette Score:",
      round(gmm_silhouette, 4))

print("\nK-Means Adjusted Rand Index:",
      round(kmeans_ari, 4))

print("GMM Adjusted Rand Index:",
      round(gmm_ari, 4))

if gmm_silhouette > kmeans_silhouette:
    print("\nGMM performed better based on Silhouette Score.")
else:
    print("\nK-Means performed better based on Silhouette Score.")

if gmm_ari > kmeans_ari:
    print("GMM performed better based on Adjusted Rand Index.")
else:
    print("K-Means performed better based on Adjusted Rand Index.")

print("\nClustering using EM Algorithm and Gaussian")
print("Mixture Model completed successfully!")
