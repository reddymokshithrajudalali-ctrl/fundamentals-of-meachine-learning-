import numpy as np
from hmmlearn import hmm

states = ["Sunny", "Cloudy", "Rainy"]

observations = ["Dry", "Humid", "Wet"]

model = hmm.CategoricalHMM(n_components=3)

model.startprob_ = np.array([0.6, 0.3, 0.1])

model.transmat_ = np.array([
    [0.7, 0.2, 0.1],
    [0.3, 0.4, 0.3],
    [0.2, 0.3, 0.5]
])

model.emissionprob_ = np.array([
    [0.8, 0.15, 0.05],
    [0.3, 0.5, 0.2],
    [0.1, 0.3, 0.6]
])

obs_sequence = np.array([[0], [1], [2], [2]])

logprob, hidden_states = model.decode(obs_sequence, algorithm="viterbi")

print("Observation Sequence:")
for obs in obs_sequence:
    print(observations[obs[0]], end=" ")

print("\n\nPredicted Hidden Weather States:")
for state in hidden_states:
    print(states[state], end=" ")
